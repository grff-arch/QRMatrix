<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>QRMatrix — Карточка #{{item.id}}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 860px; margin: 32px auto; padding: 0 16px; color: #1f2937; }
    nav { display: flex; gap: 16px; padding: 12px 16px; background: #f3f4f6; border-radius: 8px; margin-bottom: 24px; }
    nav a { text-decoration: none; color: #1d4ed8; font-weight: 600; }
    .card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 24px; display: flex; gap: 24px; align-items: center; }
    .btn { display: inline-block; margin-top: 12px; padding: 8px 14px; background: #059669; color: #fff; text-decoration: none; border-radius: 6px; }
  </style>
</head>
<body>
  <nav>
    <strong>QRMatrix</strong>
    <a href="/">Главная</a>
    <a href="/codes">Список кодов</a>
    <a href="/codes/new">Создать QR-код</a>
    <a href="/access-denied">Проверка отказа</a>
  </nav>

  <h1>QRMatrix — Карточка записи #{{item.id}}</h1>
  <div class="card">
    <img src="{{item.dataUrl}}" alt="QR Code" width="220" height="220" />
    <div>
      <h2>{{item.title}}</h2>
      <p><strong>Закодировано:</strong> <code>{{item.content}}</code></p>
      <p><strong>Цвет:</strong> {{item.color}}</p>
      <p><strong>Дата создания:</strong> {{item.createdAt}}</p>
      <a class="btn" href="{{item.dataUrl}}" download="qrmatrix-{{item.id}}.png">Скачать PNG</a>
    </div>
  </div>
</body>
</html>