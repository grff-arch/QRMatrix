<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>QRMatrix — Список кодов</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 860px; margin: 32px auto; padding: 0 16px; color: #1f2937; }
    nav { display: flex; gap: 16px; padding: 12px 16px; background: #f3f4f6; border-radius: 8px; margin-bottom: 24px; }
    nav a { text-decoration: none; color: #1d4ed8; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th, td { border: 1px solid #e5e7eb; padding: 10px; text-align: left; }
    th { background: #f9fafb; }
    .badge-private { background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
  </style>
</head>
<body>
  <nav>
    <strong>QRMatrix</strong>
    <a href="/">Главная</a>
    <a href="/codes">Список кодов</a>
    <a href="/codes/new">Создать QR-код</a>
    <a href="/access-denied">Проверка отказа</a>
  </nav>

  <h1>QRMatrix — Реестр QR-кодов</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Превью</th>
        <th>Название</th>
        <th>Содержимое</th>
        <th>Действие</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{this.id}}</td>
        <td><img src="{{this.dataUrl}}" alt="QR" width="56" height="56" /></td>
        <td>
          {{this.title}}
          {{#if this.isPrivate}}<span class="badge-private">Закрытый</span>{{/if}}
        </td>
        <td><code>{{this.content}}</code></td>
        <td><a href="/codes/{{this.id}}">Открыть карточку</a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>